# Ключи для scripts/media.mjs скилла site-rework.
# Скопируйте в .env рядом (C:\Users\<вы>\.claude\site-rework\.env) и впишите значения.
# Файл .env лежит вне любых репозиториев; сюда, в .env.example, значения не писать.
# Переменные окружения главнее файла. Без ключа источник просто пропускается.

# Pexels: фото до 6000+ px и видео 4K. Бесплатно: pexels.com/api → Your API Key.
PEXELS_API_KEY=

# Unsplash: фото (показ на сайте только по их ссылкам). Бесплатно: unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=
# Имя приложения из кабинета Unsplash (Your apps) — идёт в utm_source ссылок на автора и Unsplash;
# подпись «автор / Unsplash» со ссылками для кадров из API обязательна (правило API). Без имени — site_rework.
UNSPLASH_APP_NAME=

# Pixabay: фото до 1280 px, видео до 4K. Бесплатно после регистрации: pixabay.com/api/docs.
PIXABAY_API_KEY=

# Smithsonian Open Access (профиль art). Бесплатно: api.data.gov/signup.
SI_API_KEY=

# Контакт для User-Agent (политика Wikimedia и AIC): адрес сайта студии или рабочая почта
# для таких писем. Только эта переменная — скрипт не берёт почту из git и личные данные.
MEDIA_CONTACT=

# Recraft API (scripts/recraft.mjs): SVG-иконки, иллюстрации, паттерны, фоны. Платно: 1 $ = 1000 единиц,
# картинка $0.007–0.30. Ключ: recraft.ai → профиль → API → Generate (кнопка есть при положительном балансе API).
RECRAFT_API_TOKEN=

# Firecrawl (scripts/firecrawl.mjs): карта сайта, текст и фирменный стиль страниц, факты со ссылками.
# Бесплатно 1000 кредитов в месяц: firecrawl.dev/app → API Keys. Скилл тратит до 50 кредитов на сайт.
FIRECRAWL_API_KEY=
